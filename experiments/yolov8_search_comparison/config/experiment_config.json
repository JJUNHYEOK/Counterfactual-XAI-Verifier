{
  "experiment_id": "kci_yolov8s_boundary_search_v1",
  "scenario_id": "mountain_uav_default_layout",
  "scenario_variant": 0,
  "detector": "yolov8",
  "weights_path": "yolov8s.pt",
  "search_methods": [
    "symmetric",
    "asymmetric"
  ],
  "initial_environment": {
    "fog_percent": 5.0,
    "illumination_lux": 12000.0,
    "camera_noise": 0.02
  },
  "environment_bounds": {
    "fog_percent": [
      0.0,
      100.0
    ],
    "illumination_lux": [
      200.0,
      15000.0
    ],
    "camera_noise": [
      0.0,
      0.6
    ]
  },
  "degradation": {
    "fog_add_percent_points": 30.0,
    "illumination_multiplier": 0.5,
    "camera_noise_add": 0.2
  },
  "thresholds": {
    "pass_map50": 0.5,
    "fail_map50": 0.25
  },
  "max_evaluations": 10,
  "random_seed": 42,
  "frame_stride": 1,
  "ground_truth_mode": "rendered_instance_mask_v1",
  "retain_rendered_frames": false,
  "matlab_stop_time_seconds": 18.0,
  "yolov8": {
    "input_size": 640,
    "confidence_threshold": 0.25,
    "nms_iou_threshold": 0.7,
    "ap_iou_threshold": 0.5,
    "device": "auto",
    "batch_size": 16,
    "class_mapping": {
      "0": "person",
      "2": "vehicle",
      "3": "vehicle",
      "5": "vehicle",
      "7": "vehicle"
    },
    "class_mapping_note": "COCO person(0) is person; car(2), motorcycle(3), bus(5), and truck(7) are merged into simulation class vehicle. Bicycle(1) is excluded."
  },
  "determinism": {
    "python_random": true,
    "numpy_random": true,
    "torch_random": true,
    "torch_deterministic_algorithms": true,
    "matlab_twister_seed": true,
    "renderer_note": "Camera speckle, walking motion, scenery variants, trajectory, and object layout are deterministic functions; no synthetic replicate noise is added."
  }
}
